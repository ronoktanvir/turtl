EXPO_PUBLIC_CONVEX_URL=https://your-turtl-deployment.convex.cloud
# Public API URL only. Control credentials stay in the root Convex environment.
# This app's public intake key for "Report a problem" and "Request a feature" (from intake/keys:issue). It is not a secret.
EXPO_PUBLIC_TURTL_INTAKE_KEY=
# Optional: the intake endpoint, when it is not the deployment's .convex.site host (or port 3211 locally).
# EXPO_PUBLIC_TURTL_INTAKE_URL=https://your-turtl-deployment.convex.site/intake/report
