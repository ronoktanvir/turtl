# Copy to .env.local. `npx convex dev` fills this in for you.
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Set to 1 to show the dev tools in a non-development build. Needs DEV_TOOLS_ENABLED=true on the Convex deployment.
EXPO_PUBLIC_DEV_TOOLS=

# The build's environment name: development, preview, or production. Leave it empty for local work and the demo.
# eas.json sets it for each build profile. preview and production switch off the dev tools and example data (release/README.md).
EXPO_PUBLIC_APP_ENV=
